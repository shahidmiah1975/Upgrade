<UserControl x:Class="EZMenu.UI.Wpf.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="12">
            <TextBlock Text="Order View (POC)" FontSize="18" FontWeight="Bold" />
            <ItemsControl x:Name="ItemsList" Margin="0,8,0,8" />
            <TextBlock x:Name="TotalText" FontSize="16" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Print" Width="100" Click="Print_Click" />
                <Button Content="Close" Width="100" Margin="8,0,0,0" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
